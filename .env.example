# Sao chép file này thành .env và điền thông tin từ cổng Sandbox VNPay
# Đăng ký / đăng nhập: https://sandbox.vnpayment.vn/merchantv2/

PORT=3000
APP_URL=http://localhost:3000

# Mã website (vnp_TmnCode) và Chuỗi bí mật (vnp_HashSecret)
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET

# URL thanh toán Sandbox (mặc định, thường không cần đổi)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
